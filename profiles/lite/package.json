{
  "name": "dragon-claw-dh",
  "version": "1.7.0",
  "description": "Dragon Claw Digital Human Web Edition (Node.js 22 + Fastify + Base REST)",
  "main": "run.js",
  "engines": {
    "node": "22.21.1"
  },
  "scripts": {
    "start": "node run.js",
    "dev": "node scripts/dev.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "node scripts/check.js",
    "build": "npm run check && node scripts/build.js",
    "build:lite": "npm run check && node scripts/build.js --lite"
  },
  "dependencies": {
    "@fastify/static": "7.0.4",
    "fastify": "4.29.1",
    "pino": "9.6.0",
    "undici": "6.21.0"
  }
}