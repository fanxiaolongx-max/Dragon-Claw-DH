{
  "name": "dragon-claw-dh",
  "version": "1.0.0",
  "description": "Dragon Claw Digital Human Web Edition (Node.js 22 + Fastify + Base REST)",
  "type": "module",
  "main": "run.js",
  "engines": {
    "node": "22.21.1"
  },
  "scripts": {
    "start": "node run.js",
    "dev": "node scripts/dev.js",
