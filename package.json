    "build": "npm run check && node scripts/build.js"
  },
  "dependencies": {
    "@fastify/multipart": "8.3.1",
    "@fastify/static": "7.0.4",
    "@tutao/oxmsg": "0.2.3",
    "acorn": "8.19.0",
    "exceljs": "4.4.0",
    "fastify": "4.29.1",
    "jszip": "3.10.2",
    "pino": "9.6.0",
    "undici": "6.21.0",
    "zod": "3.24.1"
  }
}
