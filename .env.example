# 本地开发调试模板（不打入发布 zip）
PORT=8000
HOST=127.0.0.1
DEBUG=true

# 管理员工号（逗号分隔）；留空时首位已识别用户自动成为管理员
DH_ADMIN_USERS=
# 落库密钥的加密口令（见 README 安全说明）
DH_SECRET_KEY=
LOG_LEVEL=debug
HTTP_VERIFY_SSL=false
LOCAL_DEV_MEMORY=1

# 真实基座联调时填写下列由底座注入的变量（LOCAL_DEV_MEMORY=0）
BASE_URL=
BASE_QUERY_URL=
BASE_EXECUTE_URL=
BASE_DATASOURCES_URL=
BASE_FIND_TABLE_URL=
BASE_REP_OFFICES_URL=
BASE_APP_MENUS_URL=
BASE_CACHE_QUERY_URL=
BASE_CACHE_EXECUTE_URL=
BASE_NOTIFY_URL=

APP_DATASOURCE_ID=0
APP_DATASOURCE_NAME=
APP_SCHEMA=
APP_UUID=
APP_LEVEL=BUSINESS
APP_REGION=
APP_CACHE_DATASOURCE_ID=0
APP_CACHE_DATASOURCE_NAME=
BUSINESS_DATASOURCE_ID=0
BUSINESS_DATASOURCE_NAME=
SYSTEM_DATASOURCE_ID=0
SYSTEM_DATASOURCE_NAME=
